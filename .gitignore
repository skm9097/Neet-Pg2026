# Binary build artifacts — never commit
*.apk
*.aab
*.ipa
*.exe
*.dmg

# Exception: releases/ folder is for distributing APK builds via GitHub
!releases/*.apk

# Flutter build output
neet-quiz-app/build/

# Android local config
neet-quiz-app/android/local.properties
neet-quiz-app/android/.gradle/

# PDF and binary source files (raw dumps, source papers)
*.pdf
*.bin

# Exception: generated study notes PDFs
!notes/*.pdf

# PDF files (binary, not tracked)
**/*.pdf
