# Binary build artifacts — never commit
*.apk
*.aab
*.ipa
*.exe
*.dmg

# Exception: releases/ folder is for distributing app builds via GitHub
!releases/*.apk
!releases/*.exe

# Flutter build output
neet-quiz-app/build/

# Android local config
neet-quiz-app/android/local.properties
neet-quiz-app/android/.gradle/

# PDF and binary source files (raw dumps, source papers)
*.pdf
*.bin
**/*.pdf

# Exception: generated study notes PDFs (placed last so it takes precedence)
!notes/*.pdf

scripts/__pycache__/
